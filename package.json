{
  "name": "untrusted-plus",
  "version": "1.0.4",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm untrusted && next build",
    "start": "next start",
    "lint": "eslint .",
    "untrusted": "cd untrusted && make release && mkdir -p ../public/untrusted && cp -r ./{index.html,images,lib,music,scripts,sound,styles} ../public/untrusted",
    "commit": "cz",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/remove-markdown": "^0.3.4",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.8",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.33.4"
}
