{
  "name": "untrusted",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm untrusted && next build",
    "start": "next start",
    "lint": "eslint .",
    "untrusted": "cd untrusted && make release && mkdir -p ../public/untrusted && cp -r ./{index.html,images,lib,music,scripts,sound,styles} ../public/untrusted"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "next": "16.2.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/remove-markdown": "^0.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.1",
    "prettier": "^3.8.1",
    "typescript": "^5"
  }
}
